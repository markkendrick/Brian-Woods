# Apache / LiteSpeed in front of this site.
# One host: https://www.landdevspec.net
# The apex keeps the path and query and forwards there.
# Plain http on www forwards to https on the same host.
# A request that is already https on www does not match, so these rules cannot loop.
# The target sets no query of its own, so Apache and LiteSpeed keep the original query string.
# If http:// times out, port 80 never reaches this file. In Hostinger hPanel
# open the landdevspec.net website, then SSL, and turn on Force HTTPS.
<IfModule mod_rewrite.c>
RewriteEngine On

# landdevspec.net (http or https) -> https://www.landdevspec.net
RewriteCond %{HTTP_HOST} ^landdevspec\.net(:[0-9]+)?$ [NC]
RewriteRule ^ https://www.landdevspec.net%{REQUEST_URI} [L,R=301]

# http://www.landdevspec.net -> https://www.landdevspec.net
# X-Forwarded-Proto: https means a proxy already terminated TLS. Do not redirect again.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https [NC]
RewriteCond %{HTTP_HOST} ^www\.landdevspec\.net(:[0-9]+)?$ [NC]
RewriteRule ^ https://www.landdevspec.net%{REQUEST_URI} [L,R=301]
</IfModule>
